          "resultUnit": "kgCO₂e",
          "paramRefsText": "M_Fluid material_i, CEF_Fluid material_i",
          "clauseRef": "式(7)"
        },
        {
          "code": "CAR-PROD-001",
          "name": "整车生产阶段碳排放量",
          "expression": "C_Production = Σ(E_r × CEF_r + E_r × NCV_r × CEF'_r) + M_CO₂",
