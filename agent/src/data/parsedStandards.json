      "calcRules": [
        {
          "type": "适用规则",
          "content": "适用于最大设计总质量不超过3500kg的M1类车辆；含汽油、柴油、不可外接充电式混动、插电式混动、纯电动乘用车；不适用于燃用气体燃料或醇醚类燃料车辆",
          "target": "全部公式",
          "clauseRef": "第1章 范围"
        },
        {
          "type": "适用规则",
          "content": "功能单位为单位行驶里程（1km），生命周期行驶里程固定按 1.5×10⁵ km 计算",
          "target": "全部公式",
          "clauseRef": "第4.2.1条、第4.4.3条"
        },
        {
          "type": "数据规则",
          "content": "具体场地数据优先；不可行时可用缺省值；两者可混合使用",
          "target": "全部公式",
          "clauseRef": "第4.3.1条"
        },
        {
          "type": "数据规则",
          "content": "仅当材料重量使用具体场地数据时材料碳排放因子才可以使用具体场地数据",
          "target": "CAR-MAT-002~007",
          "clauseRef": "第4.3.1条"
        },
        {
          "type": "数据规则",
          "content": "时间代表性：应收集最近连续生产3个月到1年的平均水平数据；优先使用最近连续生产1年的数据",
          "target": "全部公式",
          "clauseRef": "第4.3.3.1条"
        },
        {
          "type": "数据规则",
          "content": "地理代表性：应收集实际生产地理区域的数据；技术代表性：应收集实际生产工艺技术的数据",
          "target": "全部公式",
          "clauseRef": "第4.3.3.2条、第4.3.3.3条"
        },
        {
          "type": "分配规则",
          "content": "分配优先级：避免或减少分配 > 物理关系（重量/数量/体积/面积/热值）> 经济关系（产值/利润，一般不推荐）",
          "target": "全部公式",
          "clauseRef": "第4.3.2条"
        },
        {
          "type": "分配规则",
          "content": "多重输出按产品功能和经济关联性变化；多重输入基于实际关系；分配前后总和应相等",
          "target": "全部公式",
          "clauseRef": "第4.3.2条"
        },
        {
          "type": "处理规则",
          "content": "材料取舍：材料重量占比或碳排放占比大于各部门1%的其他均质材料必须纳入；≤1%可不纳入",
          "target": "CAR-MAT-002",
          "clauseRef": "第4.2.2.2条"
        },
        {
          "type": "处理规则",
          "content": "使用阶段更换假设：轮胎按更换2次（每次4条）计算，铅酸蓄电池按更换2次计算，制冷剂按逸散1次计算",
          "target": "CAR-USE-001",
          "clauseRef": "第4.2.2.4条"
        },
        {
          "type": "处理规则",
          "content": "锂离子动力电池可选用材料法（式4）或重量法（式5）核算；单一燃用汽油或柴油乘用车动力蓄电池重量按0计算",
          "target": "CAR-MAT-004/CAR-MAT-005",
          "clauseRef": "第4.4.1条"
        },
        {
          "type": "精度规则",
          "content": "所有计算结果四舍五入（圆整）至小数点后两位",
          "target": "全部公式",
          "clauseRef": "第4.1.5条 精确度"
        },
        {
          "type": "校验规则",
          "content": "避免重复计算：每个部分只能计算一次，避免重复计算和遗漏",
          "target": "CAR-TOTAL-001",
          "clauseRef": "第4.1.7条 避免重复计算"
        },
        {
          "type": "校验规则",
          "content": "温室气体范围：《京都议定书》规定的七种（CO₂、CH₄、N₂O、HFCs、PFCs、SF₆、NF₃），GWP取100年时间框架",
          "target": "全部公式",
          "clauseRef": "第4.2.3条、第3.16条"
        },
        {
          "type": "校验规则",
          "content": "碳排放源范围：考虑能源利用、燃烧过程、化学反应、运行、废物处理；不考虑土地利用和土地利用变化",
          "target": "CAR-TOTAL-001",
          "clauseRef": "第4.2.4条"
        },
        {
          "type": "单位规则",
          "content": "碳排放量单位为千克二氧化碳当量（kgCO₂e）；材料重量单位为千克（kg），圆整至小数点后两位",
          "target": "全部公式",
          "clauseRef": "第4.4条、第4.4.1条"
        }
      ],
