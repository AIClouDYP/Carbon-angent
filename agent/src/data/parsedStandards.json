          "resultIndicator": "锂离子动力电池碳排放量",
          "resultUnit": "kgCO₂e",
          "paramRefsText": "R_Li-ion battery, CEF_Li-ion battery",
          "clauseRef": "式(5)"
        },
        {
          "code": "CAR-MAT-006",
          "name": "轮胎碳排放量",
          "expression": "C_Tyres = Σ(M_Tyre material_i × CEF_Tyres material_i)",
