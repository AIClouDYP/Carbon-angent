          "paramRefsText": "M_Lead acid battery material_i, CEF_Lead acid battery material_i",
          "clauseRef": "式(3)"
        },
        {
          "code": "CAR-MAT-004",
          "name": "锂离子动力电池碳排放量（材料法）",
          "expression": "C_Li-ion battery = Σ(M_Li-ion battery material_i × CEF_Li-ion battery material_i)",
          "resultIndicator": "锂离子动力电池碳排放量",
