      "formulas": [
        {
          "code": "CAR-MAT-001",
          "name": "原材料获取阶段碳排放量",
          "expression": "C_Materials = C_Parts + C_Lead acid battery + C_Li-ion battery + C_Tyres + C_Fluids",
          "resultIndicator": "原材料获取阶段碳排放量",
          "resultUnit": "kgCO₂e",
          "paramRefsText": "C_Parts, C_Lead acid battery, C_Li-ion battery, C_Tyres, C_Fluids",
          "clauseRef": "式(1)"
        },
        {
          "code": "CAR-MAT-002",
          "name": "部件碳排放量",
          "expression": "C_Parts = Σ(M_Port material_i × CEF_Port material_i)",
          "resultIndicator": "部件碳排放量",
          "resultUnit": "kgCO₂e",
          "paramRefsText": "M_Port material_i, CEF_Port material_i",
          "clauseRef": "式(2)"
        },
        {
          "code": "CAR-MAT-003",
          "name": "铅酸蓄电池碳排放量",
