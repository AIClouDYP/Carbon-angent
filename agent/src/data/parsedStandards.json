      "dimensions": [
        {
          "key": "principle",
          "name": "基本原则与术语",
          "type": "list",
          "points": [
            {
              "text": "核算范围：规定了中国境内生产或销售的乘用车生命周期碳排放的核算技术规范",
              "clauseRefs": [
                "第1章 范围"
              ]
            },
            {
              "text": "适用对象：最大设计总质量不超过3500kg的M1类车辆，含单一燃用汽油或柴油乘用车、不可外接充电式混合动力乘用车、插电式混合动力乘用车和纯电动乘用车",
              "clauseRefs": [
                "第1章 范围"
              ]
            },
            {
              "text": "不适用对象：不适用于燃用气体燃料或醇醚类燃料的M1类车辆",
              "clauseRefs": [
                "第1章 范围"
              ]
            },
            {
              "text": "M1类车辆定义：包括驾驶员座位在内座位数不超过九座的载客车辆",
              "clauseRefs": [
                "第3.1条 M1类车辆"
              ]
            },
            {
              "text": "乘用车定义：主要用于载运乘客及其随身行李或临时物品的汽车，最多不超过9个座位",
              "clauseRefs": [
                "第3.2条 乘用车"
              ]
            },
            {
              "text": "生命周期定义：从自然界或自然资源中获取原材料直至最终处置的一系列阶段",
              "clauseRefs": [
                "第3.5条 生命周期"
              ]
            },
            {
              "text": "碳排放源口径：考虑能源利用、燃烧过程、化学反应、运行、废物处理过程中的碳排放；不考虑土地利用和土地利用变化",
              "clauseRefs": [
                "第4.2.4条 碳排放源"
              ]
            },
            {
              "text": "温室气体范围：《京都议定书》规定的七种温室气体（二氧化碳、甲烷、氧化亚氮、氢氟碳化物、全氟碳化物、六氟化硫、三氟化氮）",
              "clauseRefs": [
                "第4.2.3条 碳（温室气体）"
              ]
            },
            {
              "text": "二氧化碳当量：等于给定温室气体质量乘以其全球增温潜势值，GWP取100年时间框架（GWP 100a）",
              "clauseRefs": [
                "第3.16条 全球增温潜势",
                "第3.17条 二氧化碳当量"
              ]
            }
          ]
        },
        {
          "key": "objective",
          "name": "研究目的与核算对象",
          "type": "list",
          "points": [
            {
              "text": "功能单位：乘用车生命周期碳排放核算围绕功能单位进行，结果相对于功能单位计算；功能单位为单位行驶里程（1km）",
              "clauseRefs": [
                "第4.1.2条 功能单位",
                "第4.2.1条"
              ]
            },
            {
              "text": "生命周期行驶里程：乘用车生命周期行驶里程按 1.5×10⁵ km 计算",
              "clauseRefs": [
                "第4.4.3条 使用阶段"
              ]
            },
            {
              "text": "产品性能描述：报告应详细描述核算的对象、功能单位和产品性能，列出产品材料构成与技术参数",
              "clauseRefs": [
                "第5.2.2.1条 核算范围"
              ]
            }
          ]
        },
        {
          "key": "pcr",
          "name": "产品类别规则与行业要求",
          "type": "list",
          "points": [
            {
              "text": "规范性引用文件：GB/T 3730.1、GB/T 15089、GB/T 18386、GB/T 19233、GB 19578、GB/T 19596、GB/T 19753、GB/T 24040、GB/T 24044、GB 27999、GB/T 30512、GB/T 32150、GB/T 32694、ISO 14067",
              "clauseRefs": [
                "第2章 规范性引用文件"
              ]
            },
            {
              "text": "燃料消耗量试验方法：汽油/柴油M1类车采用GB/T 19233；不可外接充电式混合动力采用GB/T 19753；纯电动采用GB/T 18386",
              "clauseRefs": [
                "第4.4.3条 使用阶段"
              ]
            },
            {
              "text": "禁用物质要求：材料使用应符合 GB/T 30512 汽车禁用物质要求",
              "clauseRefs": [
                "第2章 规范性引用文件"
              ]
            }
          ]
        },
        {
          "key": "boundary",
          "name": "系统边界与生命周期",
          "type": "list",
          "points": [
            {
              "text": "生命周期视角：核算包括原材料获取阶段、整车生产阶段和使用阶段三个阶段",
              "clauseRefs": [
                "第4.1.1条 生命周期视角"
              ]
            },
            {
              "text": "原材料获取阶段核算范围：包括资源开采、加工提纯、生产制造等过程；材料生产制造边界不含使用与废弃环节",
              "clauseRefs": [
                "第4.2.2.2条"
              ]
            },
            {
              "text": "材料取舍准则：材料重量占比或碳排放占比大于各部门1%但未列入表1的其他均质材料，必须纳入核算范围；≤1%可不纳入",
              "clauseRefs": [
                "第4.2.2.2条 原材料获取阶段核算范围"
              ]
            },
            {
              "text": "整车生产阶段核算范围：包括冲压、焊接、涂装、总装和动力站房等生产制造过程",
              "clauseRefs": [
                "第4.2.2.3条 整车生产阶段核算范围"
              ]
            },
            {
              "text": "使用阶段核算范围：包括燃料生产、燃料使用、轮胎更换、铅酸蓄电池更换、液体更换和制冷剂逸散",
              "clauseRefs": [
                "第4.2.2.4条 使用阶段核算范围"
              ]
            },
            {
              "text": "使用阶段更换次数假设：轮胎按更换2次（每次更换4条）计算，铅酸蓄电池按更换2次计算，制冷剂按逸散1次计算",
              "clauseRefs": [
                "第4.2.2.4条"
              ]
            },
            {
              "text": "系统边界图示：原材料获取阶段（能源/资源输入）→生产阶段（冲压/焊接/涂装/总装/动力站房）→使用阶段（燃料生产/燃料使用/轮胎更换/铅酸蓄电池更换/液体更换与制冷剂逃逸）",
              "clauseRefs": [
                "图1 乘用车生命周期碳排放系统边界"
              ]
            }
          ]
        },
        {
          "key": "data",
          "name": "数据收集与质量管理",
          "type": "list",
          "points": [
            {
              "text": "数据收集优先级：对于系统边界内所有过程，应收集具体场地数据；当收集具体场地数据不可行时，可使用缺省值",
              "clauseRefs": [
                "第4.3.1条 数据收集"
              ]
            },
            {
              "text": "数据混用规则：具体场地数据和缺省值可混合使用；仅当材料重量使用具体场地数据时材料碳排放因子才可以使用具体场地数据",
              "clauseRefs": [
                "第4.3.1条 数据收集"
              ]
            },
            {
              "text": "分配原则（五项）：识别公用过程分配前后应平衡；分配前后总和相等；多种分配程序需说明；多重输出按产品功能/经济关联性变化；多重输入基于实际关系",
              "clauseRefs": [
                "第4.3.2条 数据分配"
              ]
            },
            {
              "text": "分配处理程序：优先避免或减少分配；其次使用物理关系（重量、数量、体积、面积、热值）；最后使用经济关系（产值、利润，一般不推荐）",
              "clauseRefs": [
                "第4.3.2条 数据分配"
              ]
            },
            {
              "text": "时间代表性：应收集最近连续生产3个月到1年的平均水平数据；优先使用最近连续生产1年的平均水平数据",
              "clauseRefs": [
                "第4.3.3.1条 时间范围"
              ]
            },
            {
              "text": "地理代表性：应收集实际生产地理区域的数据",
              "clauseRefs": [
                "第4.3.3.2条 地理范围"
              ]
            },
            {
              "text": "技术代表性：应收集实际生产工艺技术或技术组合的数据",
              "clauseRefs": [
                "第4.3.3.3条 技术范围"
              ]
            },
            {
              "text": "完整性：应收集涵盖产品系统边界范围的数据",
              "clauseRefs": [
                "第4.3.3.4条 完整性"
              ]
            },
            {
              "text": "重现性：应保证独立从业人员可以重现产品碳排放的核算结果",
              "clauseRefs": [
                "第4.3.3.5条 重现性"
              ]
            },
            {
              "text": "数据来源说明：应对数据的获得方式和来源均予以说明",
              "clauseRefs": [
                "第4.3.3.6条 数据来源"
              ]
            }
          ]
        },
        {
          "key": "allocation",
          "name": "分配原则与特殊处理",
          "type": "list",
          "points": [
            {
              "text": "铅酸蓄电池核算：按材料组分分别核算（式3），使用阶段更换2次",
              "clauseRefs": [
                "第4.4.1条 式(3)",
                "第4.2.2.4条"
              ]
            },
            {
              "text": "锂离子动力电池两种算法：材料法（式4，按材料组分核算）或重量法（式5，按电池重量×因子核算）",
              "clauseRefs": [
                "第4.4.1条 式(4)/式(5)"
              ]
            },
            {
              "text": "单一燃用汽油或柴油乘用车动力蓄电池重量按0计算",
              "clauseRefs": [
                "第4.4.1条"
              ]
            },
            {
              "text": "轮胎核算：出厂轮胎按5条（含1条备胎）计算；更换轮胎按每次4条计算",
              "clauseRefs": [
                "第4.4.1条 式(6)"
              ]
            },
            {
              "text": "制冷剂逸散：使用阶段按逸散1次计算",
              "clauseRefs": [
                "第4.2.2.4条 使用阶段核算范围"
              ]
            },
            {
              "text": "燃油车电池基准：单一燃用汽油或柴油乘用车的动力蓄电池重量按0计算",
              "clauseRefs": [
                "第4.4.1条"
              ]
            }
          ]
        },
        {
          "key": "method",
          "name": "核算方法与结果评价",
          "type": "list",
          "points": [
            {
              "text": "核算原则：生命周期视角、功能单位为基准、科学方法优先、一致性、精确度（计算结果四舍五入至小数点后两位）、透明度、避免重复计算",
              "clauseRefs": [
                "第4.1条 核算原则"
              ]
            },
            {
              "text": "科学方法优先顺序：优先选择自然科学（物理、化学、生物学）方法",
              "clauseRefs": [
                "第4.1.3条 科学方法的优先顺序"
              ]
            },
            {
              "text": "精确度要求：所有计算结果四舍五入至小数点后两位",
              "clauseRefs": [
                "第4.1.5条 精确度"
              ]
            },
            {
              "text": "避免重复计算：每个部分只能计算一次，避免重复计算和遗漏",
              "clauseRefs": [
                "第4.1.7条 避免重复计算"
              ]
            },
            {
              "text": "原材料获取阶段计算：C_Materials = C_Parts + C_Lead acid battery + C_Li-ion battery + C_Tyres + C_Fluids",
              "clauseRefs": [
                "第4.4.1条 式(1)"
              ]
            },
            {
              "text": "整车生产阶段计算：C_Production = Σ(E_r × CEF_r + E_r × NCV_r × CEF'_r) + M_CO₂，含焊接CO₂逸散",
              "clauseRefs": [
                "第4.4.2条 式(8)"
              ]
            },
            {
              "text": "使用阶段计算：C_Use = C_Fuel production + C_Fuel use + C_Tyres r + C_Lead acid battery r + C_Fluids r",
              "clauseRefs": [
                "第4.4.3条 式(9)"
              ]
            },
            {
              "text": "单位：碳排放量单位为千克二氧化碳当量（kgCO₂e），最终结果为单位行驶里程碳排放量（kgCO₂e/km）",
              "clauseRefs": [
                "第4.4条 计算方法",
                "第5.2.2.3条"
              ]
            }
          ]
        },
        {
          "key": "report",
          "name": "报告披露与核查要求",
          "type": "list",
          "points": [
            {
              "text": "编制依据：按本文件给出的核算原则、范围、数据要求及计算公式核算，并编制核算报告，参见附录G",
              "clauseRefs": [
                "第5.1条 编制依据"
              ]
            },
            {
              "text": "基本信息内容：报告信息（报告编号、编制人员、审核人员、发布日期）与核算者信息（单位全称、统一社会信用代码、地址、联系人、联系方式）",
              "clauseRefs": [
                "第5.2.1条 基本信息"
              ]
            },
            {
              "text": "车辆信息标注：报告应标注乘用车主要技术参数和功能，包括车辆型号、注册商标、上市时间、整备质量、燃料类型",
              "clauseRefs": [
                "第5.2.1条 基本信息"
              ]
            },
            {
              "text": "核算范围描述：详细描述核算对象、功能单位和产品性能，列出材料构成与技术参数，绘制并说明系统边界",
              "clauseRefs": [
                "第5.2.2.1条 核算范围"
              ]
            },
            {
              "text": "清单分析要求：提供生命周期阶段、每个阶段清单数据及具体场地数据或缺省值；涉及数据分配情况应说明分配方法和结果",
              "clauseRefs": [
                "第5.2.2.2条 清单分析"
              ]
            },
            {
              "text": "碳排放量披露：报告中应提供按4.4核算方法核算的单位行驶里程的碳排放量",
              "clauseRefs": [
                "第5.2.2.3条 碳排放量"
              ]
            },
            {
              "text": "具体场地数据核算报告：材料碳排放因子具体场地数据需按照附录E提交核算报告",
              "clauseRefs": [
                "第4.3.1条 数据收集"
              ]
            }
          ]
        },
